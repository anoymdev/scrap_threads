# =========================================
# Threads Scraper - Environment Configuration
# =========================================
# Copy this file to .env and fill in your values

# --- Optional: Proxy Configuration ---
# Format: http://user:pass@host:port OR http://host:port
# PROXY_URL=http://your-proxy:port

# --- Output Configuration ---
OUTPUT_DIR=data/raw
EXPORT_DIR=data/exports

# --- Scraping Configuration ---
# Delay between requests (seconds) - min 2s recommended
REQUEST_DELAY=3
# Max posts to scrape per session
MAX_POSTS=100
# Headless browser mode (true/false)
HEADLESS=true

# --- Optional: Threads Account (for better access) ---
# WARNING: Use a dedicated scraper account, NOT your main account!
# THREADS_USERNAME=your_username
# THREADS_PASSWORD=your_password

# --- Browser Settings ---
# BROWSER_TYPE=chromium  # Options: chromium, firefox, webkit
# BROWSER_CHANNEL=chrome # Options: chrome, msedge (only applies to chromium)

# --- Logging ---
LOG_LEVEL=INFO
